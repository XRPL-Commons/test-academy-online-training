{
  "name": "XRPL Academy",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "node scripts/mint-wallets.js",
  "postAttachCommand": "echo '\\n✅ XRPL Academy ready! Your wallets are in wallets.json\\n' && cat wallets.json | node -e \"const w=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8')).wallets; console.log('  Wallet 1: '+w[0].address); console.log('  Wallet 2: '+w[1].address); console.log()\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.java",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven",
        "formulahendry.code-runner",
        "ms-vsliveshare.vsliveshare"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.fontSize": 14,
        "terminal.integrated.defaultProfile.linux": "bash",
        "code-runner.runInTerminal": true,
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  },

  "forwardPorts": [3000, 5000, 8080],

  "remoteEnv": {
    "XRPL_NETWORK": "wss://s.altnet.rippletest.net:51233",
    "XRPL_FAUCET": "https://faucet.altnet.rippletest.net/accounts"
  }
}
